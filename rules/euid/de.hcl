# Germany - EUID
#
# The registration part is the Handelsregister entry, which the courts publish
# as a register kind and a number - HRB 12345 and the like - with the local
# court carried by the register identifier of the EUID rather than by the
# number.
#
# There is no single national shape to assert: the kind, the number and their
# separators vary by Land, and the courts publish no algorithm over them. The
# rule therefore checks what is common to every entry - a non empty
# alphanumeric registration within the length the register uses - and states
# that it verifies nothing further, rather than asserting a national format
# that does not exist. The historical Go library accepted any value holding one
# alphanumeric character, which is weaker still and says so nowhere.

canonicalizer "euid" "de" {
  steps = [
    trim_whitespace(),
    remove_whitespace(),
    uppercase_ascii(),
    prepend_country_if_missing(),
  ]
}

format "euid" "de" {
  capture "register" {
    value = before_first(after_first(subject(), "DE"), ".")
  }

  capture "registration" {
    value = after_first(subject(), ".")
  }

  checks = [
    require(not(is_empty(subject())), "empty", "euid.de.empty"),
    require(starts_with(subject(), "DE"), "invalid_format", "euid.de.prefix"),
    require(contains(subject(), "."), "invalid_format", "euid.de.separator"),
    require(not(is_absent(capture.register)), "invalid_format", "euid.de.register"),
    require(length_between(capture.register, 5, 6), "invalid_length", "euid.de.register_length"),
    require(ascii_alphanumeric(capture.register), "invalid_characters", "euid.de.register_characters"),

    # The register identifier is the XJustiz court code: DEK1101R.HRB116737
    # carries K1101R, the centralised Handelsregister of the Amtsgericht
    # Hamburg. The codes are published as GDS.Gerichte on XRepository, so
    # membership is checkable and DEZZZZZ no longer passes.
    #
    # Split by length rather than listed once, because 782 of the 818 six
    # character codes start with a five character code: over one list, starting
    # with a code would not mean being one. At a fixed length it does, which is
    # what makes an exact membership expressible without a new operation.
    #
    # The list carries every court, not only those keeping a Handelsregister,
    # and the publisher marks no such distinction: K1101R is one of them and its
    # name is the only thing that says so. Narrowing by name would be our
    # inference rather than the publisher's statement, and would refuse a real
    # company the day a register court is named without the word. So this
    # establishes that the code is a court, not that the court keeps a register.
    require(
      any(
        all(
          length_eq(capture.register, 5),
          prefix_in(capture.register, [
            "A1000", "B1000", "B1001", "B1100", "B1101", "B1102", "B1103", "B1104", "B1105", "B1200",
